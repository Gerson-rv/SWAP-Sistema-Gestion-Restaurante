@model PRJ_Panaderia.Models.Cargo

@{
    ViewData["Title"] = "Editar Sueldo - " + Model.Nombre;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-xl-5 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0"><i class="bi bi-briefcase"></i> Editar Sueldo</h4>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4 text-center">
                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width:70px;height:70px;">
                            <i class="bi bi-briefcase fs-2 text-dark"></i>
                        </div>
                        <h5 class="mt-3 mb-1">@Model.Nombre</h5>
                        <span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">@(Model.Activo ? "ACTIVO" : "INACTIVO")</span>
                    </div>

                    <form asp-action="Edit" asp-route-id="@Model.IdCargo" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.IdCargo" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Sueldo (S/)</label>
                            <input type="number" name="sueldo" class="form-control form-control-lg"
                                   value="@Model.Sueldo.ToString("F2")" step="0.01" min="0.01" max="999999.99" />
                            @Html.ValidationMessage("Sueldo", new { @class = "text-danger" })
                            <small class="text-muted">Ingrese el monto del sueldo base</small>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-dark">
                                <i class="bi bi-save"></i> Guardar Sueldo
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var mensajeExito = '@Html.Raw(TempData["Exito"])';
            if (mensajeExito) {
                Swal.fire({
                    title: '¡Éxito!',
                    text: mensajeExito,
                    icon: 'success',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#28a745'
                });
            }
        });
    </script>
}
