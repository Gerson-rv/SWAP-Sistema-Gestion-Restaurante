@model IEnumerable<PRJ_Panaderia.Models.Cliente>

@{
    ViewData["Title"] = "Lista de Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-bounding-box"></i> Gestión de Clientes</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Crear Nuevo Cliente
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th class="d-none d-md-table-cell">DNI</th>
                        <th>Nombre Completo</th>
                        <th>Teléfono</th>
                        <th class="d-none d-md-table-cell">Fecha Registro</th>
                        <th>Estado</th>
                        <th class="text-center" style="width: 160px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.Activo ? "" : "table-secondary")">
                                <td>@item.IdCliente</td>
                                <td class="d-none d-md-table-cell">@item.Dni</td>
                                <td>@item.NombreCompleto</td>
                                <td>@item.Telefono</td>
                                <td class="d-none d-md-table-cell">@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">ACTIVO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">INACTIVO</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.IdCliente" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Cajero"))
                                    {
                                        <button type="button" class="btn btn-sm btn-danger btn-eliminar"
                                                data-id="@item.IdCliente" data-nombre="@item.NombreCompleto">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No hay clientes registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <input type="hidden" id="msgExito" value="@((TempData["Exito"] ?? "").ToString())" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var msg = document.getElementById('msgExito');
            if (msg && msg.value) {
                Swal.fire({ title: 'Exito!', text: msg.value, icon: 'success', confirmButtonText: 'OK', confirmButtonColor: '#28a745' });
            }

            document.querySelectorAll('.btn-eliminar').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');

                    Swal.fire({
                        title: 'Esta seguro?',
                        text: "Desea eliminar este cliente?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Si, eliminar',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            fetch('/Cliente/Delete', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                body: 'id=' + encodeURIComponent(id)
                            })
                            .then(function (res) { return res.json(); })
                            .then(function (data) {
                                if (data.success) {
                                    Swal.fire({ title: 'Eliminado!', text: data.message, icon: 'success', confirmButtonText: 'OK', confirmButtonColor: '#28a745' }).then(function () {
                                        window.location.reload();
                                    });
                                }
                            })
                            .catch(function () {
                                Swal.fire('Error', 'Ocurrio un error al eliminar.', 'error');
                            });
                        }
                    });
                });
            });
        });
    </script>
}
