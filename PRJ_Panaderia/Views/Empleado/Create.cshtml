@model PRJ_Panaderia.Models.Empleado

@{
    ViewData["Title"] = "Crear Empleado";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Crear Nuevo Empleado</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="IdCargo" class="form-label"></label>
                        <select asp-for="IdCargo" asp-items="ViewBag.Cargos" class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="IdCargo" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Nombre completo" />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Dni" class="form-label"></label>
                        <input asp-for="Dni" class="form-control" maxlength="8" placeholder="8 dígitos" />
                        <span asp-validation-for="Dni" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Usuario" class="form-label"></label>
                        <input asp-for="Usuario" class="form-control" placeholder="Usuario" />
                        <span asp-validation-for="Usuario" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <input asp-for="Contrasena" class="form-control" type="password" placeholder="Contraseña" />
                        <span asp-validation-for="Contrasena" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" maxlength="9" placeholder="9 dígitos" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="Activo" class="form-check-input" role="switch" id="chkActivo" checked />
                            <label asp-for="Activo" class="form-check-label" for="chkActivo"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
