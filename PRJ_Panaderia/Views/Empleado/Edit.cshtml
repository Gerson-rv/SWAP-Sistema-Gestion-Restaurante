@model PRJ_Panaderia.Models.Empleado

@{
    ViewData["Title"] = "Editar Empleado";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Empleado</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="IdEmpleado" />
                <input type="hidden" asp-for="FechaCreacion" />
                <input type="hidden" asp-for="Contrasena" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="IdCargo" class="form-label"></label>
                        <select asp-for="IdCargo" asp-items="ViewBag.Cargos" class="form-select" id="cboCargo">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="IdCargo" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" id="txtNombre" placeholder="Nombre completo" />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Dni" class="form-label"></label>
                        <input asp-for="Dni" class="form-control" id="txtDni" maxlength="8" placeholder="8 dígitos" />
                        <span asp-validation-for="Dni" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Usuario" class="form-label"></label>
                        <input asp-for="Usuario" class="form-control" id="txtUsuario" placeholder="Usuario" />
                        <span asp-validation-for="Usuario" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Nueva Contraseña</label>
                        <input type="password" class="form-control" id="txtContrasena" placeholder="Dejar vacío para mantener actual" />
                        <input type="hidden" name="nuevaContrasena" id="hiddenNuevaContrasena" value="" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Telefono" class="form-label"></label>
                        <input asp-for="Telefono" class="form-control" id="txtTelefono" maxlength="9" placeholder="9 dígitos" />
                        <span asp-validation-for="Telefono" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <input asp-for="Activo" class="form-check-input" role="switch" id="chkActivo" />
                            <label asp-for="Activo" class="form-check-label" for="chkActivo"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-save"></i> Actualizar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chk = document.getElementById('chkActivo');
            var cboCargo = document.getElementById('cboCargo');
            var hiddenNuevaContrasena = document.getElementById('hiddenNuevaContrasena');
            var txtContrasena = document.getElementById('txtContrasena');

            // Lista de campos a deshabilitar cuando el empleado está inactivo
            var camposEditables = [
                document.getElementById('txtNombre'),
                document.getElementById('txtDni'),
                document.getElementById('txtUsuario'),
                document.getElementById('txtTelefono'),
                cboCargo
            ];

            function toggleCampos() {
                var habilitado = chk.checked;

                camposEditables.forEach(function (campo) {
                    if (campo) {
                        campo.disabled = !habilitado;
                        campo.style.backgroundColor = habilitado ? '' : '#e9ecef';
                    }
                });
            }

            function syncContrasena() {
                hiddenNuevaContrasena.value = txtContrasena.value.trim();
            }

            // Event listeners
            chk.addEventListener('change', toggleCampos);
            txtContrasena.addEventListener('input', syncContrasena);

            // Inicializar estado
            toggleCampos();

            // Asegurar que el select envíe su valor correctamente
            // Si el select está disabled, su valor no se envía en el POST
            // Por eso necesitamos asegurarnos de que el valor se mantenga
            var form = document.querySelector('form');
            form.addEventListener('submit', function (e) {
                // Si el select está deshabilitado, habilitarlo temporalmente para enviar su valor
                if (cboCargo.disabled) {
                    cboCargo.disabled = false;
                    // Forzar que el valor se envíe
                    setTimeout(function () {
                        cboCargo.disabled = true;
                    }, 100);
                }
            });
        });
    </script>
}