@model IEnumerable<PRJ_Panaderia.Models.Empleado>

@{
    ViewData["Title"] = "Lista de Empleados";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> Gestión de Empleados</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Crear Nuevo Empleado
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th class="d-none d-md-table-cell">DNI</th>
                        <th class="d-none d-md-table-cell">Usuario</th>
                        <th>Cargo</th>
                        <th class="d-none d-lg-table-cell">Teléfono</th>
                        <th>Estado</th>
                        <th class="text-center" style="width: 160px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.Activo ? "" : "table-secondary")">
                                <td>@item.IdEmpleado</td>
                                <td>@item.NombreCompleto</td>
                                <td class="d-none d-md-table-cell">@item.Dni</td>
                                <td class="d-none d-md-table-cell">@item.Usuario</td>
                                <td>@item.NombreCargo</td>
                                <td class="d-none d-lg-table-cell">@(item.Telefono ?? "-")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">ACTIVO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">INACTIVO</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger btn-eliminar"
                                            data-id="@item.IdEmpleado" data-nombre="@item.NombreCompleto">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                No hay empleados registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var mensajeExito = '@TempData["Exito"]';
            if (mensajeExito) {
                Swal.fire({
                    title: '¡Éxito!',
                    text: mensajeExito,
                    icon: 'success',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#28a745'
                });
            }

            document.querySelectorAll('.btn-eliminar').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');

                    Swal.fire({
                        title: '¿Está seguro?',
                        text: "¿Está seguro que desea eliminar este empleado?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#dc3545',
                        cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Sí, eliminar',
                        cancelButtonText: 'Cancelar'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            fetch('/Empleado/Delete', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                body: 'id=' + encodeURIComponent(id)
                            })
                            .then(function (res) { return res.json(); })
                            .then(function (data) {
                                if (data.success) {
                                    Swal.fire({
                                        title: '¡Eliminado!',
                                        text: data.message,
                                        icon: 'success',
                                        confirmButtonText: 'OK',
                                        confirmButtonColor: '#28a745'
                                    }).then(function () {
                                        window.location.reload();
                                    });
                                } else {
                                    Swal.fire({
                                        title: 'No permitido',
                                        text: data.message,
                                        icon: 'warning',
                                        confirmButtonText: 'Entendido',
                                        confirmButtonColor: '#6c757d'
                                    });
                                }
                            })
                            .catch(function () {
                                Swal.fire('Error', 'Ocurrió un error al eliminar.', 'error');
                            });
                        }
                    });
                });
            });
        });
    </script>
}
