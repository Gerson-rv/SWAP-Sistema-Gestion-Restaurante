@model PRJ_Panaderia.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var simbolo = "S/";
}

<div class="container-fluid">
    <div class="row g-3">

        <!-- COLUMNA IZQUIERDA -->
        <div class="col-lg-7">

            <!-- Resumen del dia -->
            <h5 class="fw-bold mb-3"><i class="bi bi-bar-chart-line"></i> Resumen del Dia</h5>
            <div class="row g-2 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3" style="background:linear-gradient(135deg,#198754,#157347);color:#fff;border-radius:12px;">
                        <i class="bi bi-currency-dollar" style="font-size:1.6rem;"></i>
                        <div class="fw-bold" style="font-size:1.2rem;">@simbolo@Model.VentasHoy.ToString("N2")</div>
                        <small>Ventas</small>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3" style="background:linear-gradient(135deg,#0d6efd,#0a58ca);color:#fff;border-radius:12px;">
                        <i class="bi bi-receipt" style="font-size:1.6rem;"></i>
                        <div class="fw-bold" style="font-size:1.2rem;">@Model.PedidosHoy</div>
                        <small>Pedidos</small>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3" style="background:linear-gradient(135deg,#6f42c1,#5a32a3);color:#fff;border-radius:12px;">
                        <i class="bi bi-people" style="font-size:1.6rem;"></i>
                        <div class="fw-bold" style="font-size:1.2rem;">@Model.ClientesHoy</div>
                        <small>Clientes</small>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm text-center p-3" style="background:linear-gradient(135deg,#fd7e14,#d96c0a);color:#fff;border-radius:12px;">
                        <i class="bi bi-cash-coin" style="font-size:1.6rem;"></i>
                        <div class="fw-bold" style="font-size:1.2rem;">@simbolo@Model.IngresosHoy.ToString("N2")</div>
                        <small>Ingresos</small>
                    </div>
                </div>
            </div>

            <!-- Ultimos pedidos -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history"></i> Ultimos Pedidos</h5>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-dark @(Model.ItemsPorPagina == 5 ? "active" : "")" asp-action="Index" asp-route-top="5">5</a>
                    <a class="btn btn-outline-dark @(Model.ItemsPorPagina == 10 ? "active" : "")" asp-action="Index" asp-route-top="10">10</a>
                </div>
            </div>
            <div class="card shadow-sm border-0 mb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Mesa</th>
                                <th>Cliente</th>
                                <th>Total</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.UltimosPedidos.Count == 0)
                            {
                                <tr><td colspan="5" class="text-center text-muted py-3">Sin pedidos hoy</td></tr>
                            }
                            @foreach (var p in Model.UltimosPedidos)
                            {
                                <tr>
                                    <td>C-@p.PedidoID.ToString("D4")</td>
                                    <td>@(p.NumeroMesa.HasValue ? "Mesa " + p.NumeroMesa.ToString() : "Llevar")</td>
                                    <td>@(p.NombreCliente ?? "-")</td>
                                    <td><strong>@simbolo@p.Total.ToString("N2")</strong></td>
                                    <td>
                                        @switch (p.Estado)
                                        {
                                            case "Pendiente": <span class="badge bg-warning text-dark">Pendiente</span>; break;
                                            case "Pagado": <span class="badge bg-success">Pagado</span>; break;
                                            case "Anulado": <span class="badge bg-danger">Anulado</span>; break;
                                            default: <span class="badge bg-secondary">@p.Estado</span>; break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Platos mas pedidos -->
            <h5 class="fw-bold mb-2"><i class="bi bi-egg-fried"></i> Platos Mas Pedidos</h5>
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    @if (Model.PlatosTop.Count == 0)
                    {
                        <p class="text-muted text-center mb-0">Sin datos</p>
                    }
                    else
                    {
                        var maxCant = Model.PlatosTop.Max(x => x.Cantidad);
                        foreach (var item in Model.PlatosTop.Select((v, i) => new { v, i }))
                        {
                            var pct = maxCant > 0 ? (item.v.Cantidad * 100 / maxCant) : 0;
                            <div class="mb-2">
                                <div class="d-flex justify-content-between small">
                                    <span><strong>@(item.i + 1).</strong> @item.v.Nombre</span>
                                    <span class="fw-bold">@item.v.Cantidad</span>
                                </div>
                                <div class="progress" style="height:8px;">
                                    <div class="progress-bar bg-dark" style="width:@(pct)%;" role="progressbar"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        <!-- COLUMNA DERECHA -->
        <div class="col-lg-5">

            <!-- Ventas 7 dias -->
            <h5 class="fw-bold mb-2"><i class="bi bi-graph-up"></i> Ventas 7 Dias</h5>
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body" style="min-height:200px;">
                    @if (Model.Ventas7Dias.Count == 0)
                    {
                        <p class="text-muted text-center mb-0">Sin datos</p>
                    }
                    else
                    {
                        var maxVenta = Model.Ventas7Dias.Max(v => v.Total);
                        <div class="d-flex align-items-end justify-content-around" style="height:170px;">
                            @foreach (var v in Model.Ventas7Dias)
                            {
                                var altura = maxVenta > 0 ? (v.Total * 150 / maxVenta) : 0;
                                <div class="text-center" style="width:40px;">
                                    <div style="height:@(altura)px; background:linear-gradient(to top, #0f3460, #1a5276); border-radius:6px 6px 0 0; min-height:4px; transition:height 0.3s;"></div>
                                    <small class="text-muted" style="font-size:0.65rem;">@v.DiaAbrev</small>
                                    <br />
                                    <small style="font-size:0.6rem;font-weight:600;">@simbolo@v.Total.ToString("N0")</small>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Acceso rapido -->
            <h5 class="fw-bold mb-2"><i class="bi bi-lightning"></i> Acceso Rapido</h5>
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <a class="btn btn-dark w-100 py-3" asp-controller="Pedido" asp-action="Index">
                        <i class="bi bi-bag-check" style="font-size:1.5rem;display:block;"></i>
                        <small>Pedido</small>
                    </a>
                </div>
                <div class="col-6">
                    <a class="btn btn-outline-dark w-100 py-3" asp-controller="DetallePedido" asp-action="Index">
                        <i class="bi bi-list-ul" style="font-size:1.5rem;display:block;"></i>
                        <small>Listar</small>
                    </a>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <div class="col-6">
                        <a class="btn btn-outline-dark w-100 py-3" asp-controller="Auditoria" asp-action="Index">
                            <i class="bi bi-file-earmark-text" style="font-size:1.5rem;display:block;"></i>
                            <small>Reporte</small>
                        </a>
                    </div>
                    <div class="col-6">
                        <a class="btn btn-outline-dark w-100 py-3" asp-controller="Cliente" asp-action="Index">
                            <i class="bi bi-person-bounding-box" style="font-size:1.5rem;display:block;"></i>
                            <small>Cliente</small>
                        </a>
                    </div>
                }
                else
                {
                    <div class="col-6">
                        <a class="btn btn-outline-dark w-100 py-3" asp-controller="Producto" asp-action="Index">
                            <i class="bi bi-box-seam" style="font-size:1.5rem;display:block;"></i>
                            <small>Productos</small>
                        </a>
                    </div>
                    <div class="col-6">
                        <a class="btn btn-outline-dark w-100 py-3" asp-controller="Mesa" asp-action="Index">
                            <i class="bi bi-grid-3x3-gap" style="font-size:1.5rem;display:block;"></i>
                            <small>Mesas</small>
                        </a>
                    </div>
                }
            </div>

            <!-- Mesas -->
            <h5 class="fw-bold mb-2"><i class="bi bi-grid-3x3-gap"></i> Mesas</h5>
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    @if (Model.Mesas.Count == 0)
                    {
                        <p class="text-muted text-center mb-0">Sin mesas registradas</p>
                    }
                    else
                    {
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            @foreach (var m in Model.Mesas)
                            {
                                var ocupada = m.Estado == "Ocupada";
                                <div class="text-center p-2 rounded @(ocupada ? "bg-danger bg-opacity-10 border border-danger" : "bg-success bg-opacity-10 border border-success")"
                                     style="width:70px; cursor:pointer;"
                                     title="@(ocupada ? $"Ocupada - {m.NombreEmpleado ?? "Sin empleado"}" : "Libre")"
                                     onclick="window.location.href='/Mesa/Index'">
                                    <i class="bi bi-circle-fill @(ocupada ? "text-danger" : "text-success")" style="font-size:0.8rem;"></i>
                                    <div class="fw-bold small">@m.Numero</div>
                                    @if (ocupada && !string.IsNullOrEmpty(m.NombreEmpleado))
                                    {
                                        <small class="text-muted" style="font-size:0.6rem;">@m.NombreEmpleado</small>
                                    }
                                </div>
                            }
                        </div>
                    }
                    <div class="mt-2 small text-muted text-center">
                        <span class="text-success">&#9679;</span> Libre &nbsp; <span class="text-danger">&#9679;</span> Ocupada
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
