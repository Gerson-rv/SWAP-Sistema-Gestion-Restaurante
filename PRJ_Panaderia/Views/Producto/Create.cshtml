@model PRJ_Panaderia.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Crear Nuevo Producto</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="IdCategoria" class="form-label"></label>
                            <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ingrese el nombre del producto" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label"></label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Imagen del Producto</label>
                            <input type="file" name="archivoImagen" class="form-control" accept=".jpg,.jpeg,.png" id="fileImagen" required />
                            <span asp-validation-for="RutaImagen" class="text-danger"></span>
                            <small class="text-muted">Formatos permitidos: JPG, JPEG, PNG. Máximo 5 MB.</small>
                        </div>

                        <div class="mb-3 text-center" id="contenedorPreview" style="display:none;">
                            <img id="imgPreview" src="#" alt="Vista previa" class="img-fluid rounded" style="max-height: 150px;" />
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input asp-for="Activo" class="form-check-input" role="switch" id="chkActivo" checked />
                            <label asp-for="Activo" class="form-check-label" for="chkActivo"></label>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> Guardar
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var fileImagen = document.getElementById('fileImagen');
            var imgPreview = document.getElementById('imgPreview');
            var contenedorPreview = document.getElementById('contenedorPreview');
            var form = fileImagen.closest('form');
            var extensionesPermitidas = ['.jpg', '.jpeg', '.png'];
            var tamanoMaximo = 5 * 1024 * 1024;

            function validarImagen(archivo) {
                if (!archivo) {
                    Swal.fire('Imagen requerida', 'Debe seleccionar una imagen del producto.', 'warning');
                    return false;
                }
                var nombre = archivo.name.toLowerCase();
                var extension = nombre.substring(nombre.lastIndexOf('.'));
                if (!extensionesPermitidas.includes(extension)) {
                    Swal.fire('Formato no permitido', 'Solo se permiten archivos JPG, JPEG o PNG.', 'error');
                    return false;
                }
                if (archivo.size > tamanoMaximo) {
                    Swal.fire('Archivo muy grande', 'El archivo no debe superar los 5 MB.', 'error');
                    return false;
                }
                return true;
            }

            form.addEventListener('submit', function (e) {
                var archivo = fileImagen.files[0];
                if (!validarImagen(archivo)) {
                    e.preventDefault();
                }
            });

            fileImagen.addEventListener('change', function (e) {
                var archivo = e.target.files[0];
                if (archivo) {
                    if (!validarImagen(archivo)) {
                        fileImagen.value = '';
                        contenedorPreview.style.display = 'none';
                        return;
                    }
                    var lector = new FileReader();
                    lector.onload = function (event) {
                        imgPreview.src = event.target.result;
                        contenedorPreview.style.display = 'block';
                    };
                    lector.readAsDataURL(archivo);
                } else {
                    contenedorPreview.style.display = 'none';
                }
            });
        });
    </script>
}
