@model PRJ_Panaderia.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Producto</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="IdProducto" />
                        <input type="hidden" asp-for="FechaCreacion" />
                        <input type="hidden" asp-for="RutaImagen" id="hiddenRutaImagen" />
                        <input type="hidden" asp-for="IdCategoria" id="hiddenIdCategoria" />

                        <div class="mb-3">
                            <label asp-for="IdCategoria" class="form-label"></label>
                            <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select" id="ddlCategoria">
                                <option value="">-- Seleccione --</option>
                            </select>
                            <span asp-validation-for="IdCategoria" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" id="txtNombre" placeholder="Ingrese el nombre del producto" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label"></label>
                            <input asp-for="Precio" class="form-control" id="txtPrecio" type="number" step="0.01" min="0.01" placeholder="0.00" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Imagen del Producto</label>
                            <input type="file" name="archivoImagen" class="form-control" accept=".jpg,.jpeg,.png" id="fileImagen" />
                            <span asp-validation-for="RutaImagen" class="text-danger"></span>
                            <small class="text-muted">Formatos permitidos: JPG, JPEG, PNG. Máximo 5 MB. Deje vacío para mantener la imagen actual.</small>
                        </div>

                        <div class="mb-3 text-center" id="contenedorPreview">
                            @if (!string.IsNullOrEmpty(Model.RutaImagen))
                            {
                                <img id="imgPreview" src="~/@Model.RutaImagen" alt="Imagen actual" class="img-fluid rounded" style="max-height: 150px;" />
                            }
                            else
                            {
                                <img id="imgPreview" src="~/Images/Productos/default.svg" alt="Sin imagen" class="img-fluid rounded" style="max-height: 150px;" />
                            }
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input asp-for="Activo" class="form-check-input" role="switch" id="chkActivo" />
                            <label asp-for="Activo" class="form-check-label" for="chkActivo"></label>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-save"></i> Actualizar
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var chk = document.getElementById('chkActivo');
            var ddlCategoria = document.getElementById('ddlCategoria');
            var hiddenIdCategoria = document.getElementById('hiddenIdCategoria');
            var txtNombre = document.getElementById('txtNombre');
            var txtPrecio = document.getElementById('txtPrecio');
            var fileImagen = document.getElementById('fileImagen');
            var imgPreview = document.getElementById('imgPreview');
            var contenedorPreview = document.getElementById('contenedorPreview');
            var form = fileImagen.closest('form');
            var extensionesPermitidas = ['.jpg', '.jpeg', '.png'];
            var tamanoMaximo = 5 * 1024 * 1024;

            function validarImagen(archivo) {
                if (!archivo) return true;
                var nombre = archivo.name.toLowerCase();
                var extension = nombre.substring(nombre.lastIndexOf('.'));
                if (!extensionesPermitidas.includes(extension)) {
                    Swal.fire('Formato no permitido', 'Solo se permiten archivos JPG, JPEG o PNG.', 'error');
                    return false;
                }
                if (archivo.size > tamanoMaximo) {
                    Swal.fire('Archivo muy grande', 'El archivo no debe superar los 5 MB.', 'error');
                    return false;
                }
                return true;
            }

            form.addEventListener('submit', function (e) {
                var archivo = fileImagen.files[0];
                if (archivo && !validarImagen(archivo)) {
                    e.preventDefault();
                }
            });

            fileImagen.addEventListener('change', function (e) {
                var archivo = e.target.files[0];
                if (archivo) {
                    if (!validarImagen(archivo)) {
                        fileImagen.value = '';
                        return;
                    }
                    var lector = new FileReader();
                    lector.onload = function (event) {
                        imgPreview.src = event.target.result;
                        contenedorPreview.style.display = 'block';
                    };
                    lector.readAsDataURL(archivo);
                }
            });

            function syncHiddenCategoria() {
                hiddenIdCategoria.value = ddlCategoria.value;
            }

            function toggleCampos() {
                var soloLectura = !chk.checked;
                ddlCategoria.disabled = soloLectura;
                ddlCategoria.style.backgroundColor = soloLectura ? '#e9ecef' : '';
                txtNombre.readOnly = soloLectura;
                txtPrecio.readOnly = soloLectura;
                fileImagen.disabled = soloLectura;
                txtNombre.style.backgroundColor = soloLectura ? '#e9ecef' : '';
                txtPrecio.style.backgroundColor = soloLectura ? '#e9ecef' : '';
                syncHiddenCategoria();
            }

            ddlCategoria.addEventListener('change', syncHiddenCategoria);
            toggleCampos();
            chk.addEventListener('change', toggleCampos);
        });
    </script>
}
