<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PRJ_Panaderia</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/SideBarAdministrativo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PRJ_Panaderia.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="bi bi-fire"></i>
            </div>
            <h5 class="brand-title">Chifa Percy</h5>
            <small class="brand-subtitle">Sabor que conquista</small>
        </div>

        <nav class="sidebar-menu">
            <div class="menu-label">Menu</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
               asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door"></i>
                <span>Dashboard</span>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cargo" ? "active" : "")"
                   asp-controller="Cargo" asp-action="Index">
                    <i class="bi bi-briefcase"></i>
                    <span>Cargos</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Empleado" ? "active" : "")"
                   asp-controller="Empleado" asp-action="Index">
                    <i class="bi bi-people"></i>
                    <span>Empleados</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categoria" ? "active" : "")"
                   asp-controller="Categoria" asp-action="Index">
                    <i class="bi bi-tags"></i>
                    <span>Categorías</span>
                </a>
            }
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "active" : "")"
               asp-controller="Cliente" asp-action="Index">
                <i class="bi bi-person-bounding-box"></i>
                <span>Clientes</span>
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Mesa" ? "active" : "")"
               asp-controller="Mesa" asp-action="Index">
                <i class="bi bi-grid-3x3-gap"></i>
                <span>Mesas</span>
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "active" : "")"
               asp-controller="Producto" asp-action="Index">
                <i class="bi bi-box-seam"></i>
                <span>Productos</span>
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pedido" ? "active" : "")"
               asp-controller="Pedido" asp-action="Index">
                <i class="bi bi-bag-check"></i>
                <span>Pedidos</span>
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DetallePedido" ? "active" : "")"
               asp-controller="DetallePedido" asp-action="Index">
                <i class="bi bi-list-ul"></i>
                <span>Detalle Pedidos</span>
            </a>
            @if (User.IsInRole("Admin") || User.IsInRole("Cajero"))
            {
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pago" ? "active" : "")"
                   asp-controller="Pago" asp-action="Listado">
                    <i class="bi bi-credit-card"></i>
                    <span>Pagos</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TurnoCaja" ? "active" : "")"
                   asp-controller="TurnoCaja" asp-action="Index">
                    <i class="bi bi-cash-stack"></i>
                    <span>Turnos Caja</span>
                </a>
            }
            @if (User.IsInRole("Admin"))
            {
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Configuracion" ? "active" : "")"
                   asp-controller="Configuracion" asp-action="Index">
                    <i class="bi bi-gear"></i>
                    <span>Configuracion</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Auditoria" ? "active" : "")"
                   asp-controller="Auditoria" asp-action="Index">
                    <i class="bi bi-journal-text"></i>
                    <span>Auditoria</span>
                </a>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="footer-icon">
                <i class="bi bi-shop"></i>
            </div>
            <h6>Chifa Percy</h6>
            <small>Desde 2018</small>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Topbar -->
        <div class="topbar d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <button class="btn-toggle-sidebar" id="btnToggleSidebar" type="button">
                    <i class="bi bi-list"></i>
                </button>
                <span class="topbar-brand">Chifa Percy</span>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="dropdown">
                    <button class="btn btn-dark btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-md-inline">@User.Identity.Name</span>
                        <span class="badge bg-light text-dark d-none d-md-inline">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <span class="dropdown-item-text">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-person-circle me-2" style="font-size:2rem;"></i>
                                    <div>
                                        <div class="fw-bold">@User.Identity.Name</div>
                                        <small class="text-muted">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</small>
                                    </div>
                                </div>
                            </span>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item text-danger" asp-controller="Login" asp-action="Logout">
                                <i class="bi bi-box-arrow-left me-2"></i> Cerrar Sesion
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </div>

        <!-- Page Content -->
        <div class="container-fluid p-4">
            @RenderBody()
        </div>

        <!-- Footer -->
        <div class="page-footer">
            &copy; 2026 - Chifa Percy | Sistema de Gestion
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebarOverlay');
            var btnToggle = document.getElementById('btnToggleSidebar');

            function openSidebar() {
                sidebar.classList.add('show');
                overlay.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.remove('show');
                overlay.classList.remove('show');
                document.body.style.overflow = '';
            }

            btnToggle.addEventListener('click', function () {
                if (sidebar.classList.contains('show')) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });

            overlay.addEventListener('click', closeSidebar);

            sidebar.querySelectorAll('.nav-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth <= 991) {
                        closeSidebar();
                    }
                });
                link.addEventListener('touchend', function (e) {
                    if (window.innerWidth <= 991) {
                        closeSidebar();
                    }
                });
            });

            window.addEventListener('resize', function () {
                if (window.innerWidth > 991) {
                    closeSidebar();
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
