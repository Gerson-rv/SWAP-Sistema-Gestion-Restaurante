@model PRJ_Panaderia.Models.TurnoCaja

@{
    ViewData["Title"] = "Abrir Turno de Caja";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Abrir Turno de Caja</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="IdEmpleado" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Empleado</label>
                            <input type="text" class="form-control" value="@ViewBag.NombreEmpleado" readonly
                                   style="background-color:#f8f9fa;" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="MontoInicial" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">S/</span>
                                <input asp-for="MontoInicial" class="form-control" type="number" step="0.01" min="0"
                                       placeholder="0.00" />
                            </div>
                            <span asp-validation-for="MontoInicial" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Observaciones" class="form-label fw-semibold"></label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="200"
                                      placeholder="Observaciones de apertura (opcional)"></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-lg"></i> Abrir Turno
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}