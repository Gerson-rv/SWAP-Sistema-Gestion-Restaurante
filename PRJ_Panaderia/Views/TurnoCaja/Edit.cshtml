@model PRJ_Panaderia.Models.TurnoCaja

@{
    ViewData["Title"] = "Editar Turno de Caja";
    var esAbierto = Model.EstaAbierto;
    var headerClass = esAbierto ? "bg-warning" : "bg-secondary";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header @headerClass">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Editar Turno de Caja
                        @if (!esAbierto)
                        {
                            <span class="badge bg-danger ms-2">Cerrado</span>
                        }
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="IdTurno" />

                        <!-- Info del turno -->
                        <div class="mb-3 p-3 rounded" style="background-color: #f8f9fa;">
                            <small class="text-muted d-block">Fecha Apertura: <strong>@Model.FechaApertura.ToString("dd/MM/yyyy HH:mm")</strong></small>
                            @if (Model.FechaCierre.HasValue)
                            {
                                <small class="text-muted d-block">Fecha Cierre: <strong>@Model.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")</strong></small>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="IdEmpleado" class="form-label fw-semibold"></label>
                            @if (esAbierto)
                            {
                                <select asp-for="IdEmpleado" asp-items="@(ViewBag.Empleados as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()))" class="form-select" id="cboEmpleado">
                                    <option value="">-- Seleccione un empleado --</option>
                                </select>
                            }
                            else
                            {
                                <select asp-for="IdEmpleado" asp-items="@(ViewBag.Empleados as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()))" class="form-select" disabled>
                                    <option value="">-- Seleccione un empleado --</option>
                                </select>
                                <input type="hidden" asp-for="IdEmpleado" />
                            }
                            <span asp-validation-for="IdEmpleado" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MontoInicial" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text">S/</span>
                                @if (esAbierto)
                                {
                                    <input asp-for="MontoInicial" class="form-control" type="number" step="0.01" min="0"
                                           placeholder="0.00" id="txtMontoInicial" />
                                }
                                else
                                {
                                    <input asp-for="MontoInicial" class="form-control" type="number" step="0.01" min="0"
                                           placeholder="0.00" readonly />
                                }
                            </div>
                            <span asp-validation-for="MontoInicial" class="text-danger"></span>
                        </div>

                        @if (!esAbierto && Model.MontoCierre.HasValue)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Monto Cierre</label>
                                <div class="input-group">
                                    <span class="input-group-text">S/</span>
                                    <input type="text" class="form-control" value="@Model.MontoCierre.Value.ToString("N2")" readonly />
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Observaciones" class="form-label fw-semibold"></label>
                            @if (esAbierto)
                            {
                                <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="200"
                                          placeholder="Observaciones (opcional)" id="txtObservaciones"></textarea>
                            }
                            else
                            {
                                <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="200"
                                          placeholder="Observaciones (opcional)" readonly></textarea>
                            }
                            <span asp-validation-for="Observaciones" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            @if (esAbierto)
                            {
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-save"></i> Actualizar
                                </button>
                            }
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Volver
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}